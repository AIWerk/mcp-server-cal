{
  "name": "@aiwerk/mcp-server-cal",
  "version": "1.0.5",
  "description": "Cal.com scheduling MCP server - manage bookings, event types, and availability",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "mcp-server-cal": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "bash $HOME/agent-memory/commons/scripts/prepublish-safety.sh && npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "cal.com",
    "scheduling",
    "calendar",
    "booking"
  ],
  "author": "AIWerk <kontakt@aiwerk.ch>",
  "license": "MIT",
  "homepage": "https://aiwerkmcp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/AIWerk/mcp-server-cal.git"
  },
  "bugs": {
    "url": "https://github.com/AIWerk/mcp-server-cal/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.1"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
